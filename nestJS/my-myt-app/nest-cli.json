{
  "monorepo": true,
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "projects": {
    "my-client": {
      "type": "application",
      "root": "apps/my-client",
      "entryFile": "main",
      "sourceRoot": "apps/my-client/src",
      "compilerOptions": {
        "tsConfigPath": "apps/my-client/tsconfig.app.json"
      }
    },
    "my-server": {
      "type": "application",
      "root": "apps/my-server",
      "entryFile": "main",
      "sourceRoot": "apps/my-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/my-server/tsconfig.app.json"
      }
    }
  }
}